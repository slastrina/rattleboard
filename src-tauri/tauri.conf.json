{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rattleboard",
  "version": "0.10.4",
  "identifier": "io.github.slastrina.rattleboard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A split-flap message board for your Mac, PC or Linux desktop",
    "longDescription": "Rattleboard is a split-flap message board for your desktop: a pop-up, a pinned widget or full screen. Compose messages and sequences, send them to your other boards, run a calm rotation of clocks, weather, countdowns and feeds, and let scripts post to its built-in API.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "recommends": ["gnome-keyring"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQURBMkI1M0U1MkNFRjEKUldUeHpsSSt0YUt0VXMrSUErclZkTGg1T0ZYcVR4aHdOR0R1WUt1a0RjRkJOZmh1Y3FTVC9oT0YK",
      "endpoints": ["https://github.com/slastrina/rattleboard/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
